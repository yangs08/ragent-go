# HTTP service
RAGENT_HTTP_ADDR=127.0.0.1:8080
RAGENT_SHUTDOWN_TIMEOUT=5s
RAGENT_LOG_LEVEL=INFO

# Model check: fill these only when using your authorized provider.
RAGENT_MODEL_BASE_URL=
RAGENT_MODEL_NAME=
RAGENT_MODEL_API_KEY=
RAGENT_MODEL_TIMEOUT=20s
RAGENT_MODEL_PROMPT="请用一句话解释什么是 Agent。"

# Read-only order Agent demo. Identity is fixed by the program, not the model.
RAGENT_AGENT_PROMPT="查询 A100 订单的状态，请先调用订单工具再回答。"
RAGENT_AGENT_MAX_ITERATIONS=4
RAGENT_AGENT_MAX_TOOL_CALLS=3
RAGENT_AGENT_TIMEOUT=30s

# 正整数；默认 256，按实际回答长度调整
RAGENT_MODEL_MAX_COMPLETION_TOKENS=256

# PostgreSQL (optional for health-only server; required for migrate/dbcheck)
RAGENT_DB_ENABLED=false
RAGENT_DB_HOST=127.0.0.1
RAGENT_DB_PORT=15432
RAGENT_DB_NAME=ragent_go
RAGENT_DB_USER=ragent
RAGENT_DB_PASSWORD=
RAGENT_DB_SSLMODE=disable
RAGENT_DB_MAX_OPEN_CONNS=10
RAGENT_DB_MAX_IDLE_CONNS=5
RAGENT_DB_CONNECT_TIMEOUT=5s
RAGENT_DB_CONN_MAX_LIFETIME=30m
RAGENT_DB_CONN_MAX_IDLE_TIME=5m

# Authentication: requires PostgreSQL and migration version 2
RAGENT_AUTH_SESSION_TTL=24h
RAGENT_AUTH_REQUEST_TIMEOUT=5s
RAGENT_AUTH_LOGIN_WINDOW=1m
RAGENT_AUTH_LOGIN_ATTEMPTS=10
