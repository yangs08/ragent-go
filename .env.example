# HTTP service
RAGENT_HTTP_ADDR=127.0.0.1:8080
RAGENT_SHUTDOWN_TIMEOUT=5s
RAGENT_LOG_LEVEL=INFO

# Model check: fill these only when using your authorized provider.
RAGENT_MODEL_BASE_URL=
RAGENT_MODEL_NAME=
RAGENT_MODEL_API_KEY=
RAGENT_MODEL_TIMEOUT=20s
RAGENT_MODEL_PROMPT="请用一句话解释什么是 Agent。"

# Read-only order Agent demo. Identity is fixed by the program, not the model.
RAGENT_AGENT_PROMPT="查询 A100 订单的状态，请先调用订单工具再回答。"
RAGENT_AGENT_MAX_ITERATIONS=4
RAGENT_AGENT_MAX_TOOL_CALLS=3
RAGENT_AGENT_TIMEOUT=30s
